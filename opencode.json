{
  "$schema": "https://opencode.ai/config.json",
  "model": "aws-bedrock-mantle/deepseek.v3.2",
  "provider": {
    "aws-bedrock-mantle": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AWS Bedrock Mantle",
      "options": {
        "baseURL": "https://bedrock-mantle.ap-south-1.api.aws/v1",
        "apiKey": "{env:AWS_BEARER_TOKEN_BEDROCK}",
        "headers": {
          "OpenAI-Project": "default"
        }
      },
      "models": {
        "deepseek.v3.2": {
          "name": "DeepSeek V3.2",
          "tool_call": true
        }
      }
    }
  }
}
